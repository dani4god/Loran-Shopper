{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix ../api ci",
  "buildCommand": "npm --prefix ../api run build && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/v1(?:/.*)?",
      "dest": "/api/index"
    },
    {
      "src": "/webhooks/paystack",
      "dest": "/api/index"
    },
    {
      "src": "/payment-return",
      "dest": "/api/index"
    },
    {
      "src": "/health",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}